# 真实数据库端到端测试的连接信息。
#
# 用法：
#   cp .env.live.example .env.live
#   # 填入下面的值
#   ./scripts/run-live-tests.sh
#
# 测试会在这些服务器上创建并删除名为 datasync_live_* 的临时库/模式，
# 不会碰你已有的任何数据。只填 MySQL 或只填 PG 也可以，
# 两边都填时还会额外跑一个 MySQL → PostgreSQL 的跨库迁移测试。

# --- MySQL ---------------------------------------------------------------
DATASYNC_MYSQL_HOST=127.0.0.1
DATASYNC_MYSQL_PORT=3306
DATASYNC_MYSQL_USER=root
DATASYNC_MYSQL_PASSWORD=

# --- PostgreSQL ----------------------------------------------------------
DATASYNC_PG_HOST=127.0.0.1
DATASYNC_PG_PORT=5432
DATASYNC_PG_USER=postgres
DATASYNC_PG_PASSWORD=
# 用于连接并创建临时 schema 的维护库
DATASYNC_PG_DATABASE=postgres
